---
title: "Blog — COR"
description: "Practical GTM guidance for lean B2B SaaS teams: warm prospecting, AI search visibility, and content that converts. From the team building COR."
canonicalUrl: "https://corgtm.com/blog/"
ogType: "website"
permalink: /blog/index.html
layout: false
---
{% extends "base.njk" %}

{% block structuredData %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "COR Blog",
  "url": "https://corgtm.com/blog/",
  "description": "Practical GTM guidance for lean B2B SaaS teams.",
  "publisher": { "@type": "Organization", "name": "COR", "url": "https://corgtm.com/" }
}
</script>
{% endblock %}

{% block fonts %}
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}

{% block styles %}
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --blue: #2B7CE9;
    --blue-dark: #1A5FC4;
    --blue-light: #E8F1FD;
    --dark-bg: #0D0F14;
    --dark-border: rgba(255,255,255,0.08);
    --dark-text: #F0F2F7;
    --dark-muted: rgba(240,242,247,0.55);
    --light-bg: #F7F8FA;
    --light-surface: #FFFFFF;
    --light-border: #E4E6EA;
    --text-primary: #111318;
    --text-secondary: #5A5E6B;
    --text-tertiary: #9096A4;
    --font: 'DM Sans', sans-serif;
    --mono: 'DM Mono', monospace;
    --radius: 10px;
    --radius-lg: 16px;
  }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font); font-size: 16px; line-height: 1.6; color: var(--text-primary); background: var(--light-bg); -webkit-font-smoothing: antialiased; }

  /* NAV */
  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(13,15,20,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--dark-border); padding: 0 2rem; height: 60px; display: flex; align-items: center; justify-content: space-between; }
  .nav-logo { text-decoration: none; display: flex; align-items: center; }
  .nav-logo-img { height: 28px; width: auto; }
  .nav-links { display: flex; align-items: center; gap: 2rem; }
  .nav-links a { color: var(--dark-muted); text-decoration: none; font-size: 14px; font-weight: 400; transition: color 0.2s; }
  .nav-links a:hover { color: #fff; }
  .nav-cta { background: var(--blue) !important; color: #fff !important; padding: 8px 18px; border-radius: 8px; font-weight: 500 !important; font-size: 14px !important; text-decoration: none; transition: background 0.2s; }
  .nav-cta:hover { background: var(--blue-dark) !important; }

  /* HEADER */
  .blog-wrap { max-width: 780px; margin: 0 auto; padding: 120px 1.5rem 4rem; }
  .blog-eyebrow { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--blue); margin-bottom: 0.75rem; }
  .blog-header h1 { font-size: clamp(32px, 4vw, 46px); font-weight: 600; letter-spacing: -0.8px; line-height: 1.12; margin-bottom: 0.75rem; }
  .blog-header p { color: var(--text-secondary); font-size: 17px; max-width: 560px; margin-bottom: 3rem; }

  /* POST LIST */
  .post-card { display: block; background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 1.6rem 1.8rem; margin-bottom: 1rem; text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
  .post-card:hover { border-color: var(--blue); transform: translateY(-1px); }
  .post-card-meta { font-family: var(--mono); font-size: 12px; color: var(--text-tertiary); margin-bottom: 0.5rem; display: flex; gap: 1rem; }
  .post-card h2 { font-size: 21px; font-weight: 600; letter-spacing: -0.3px; line-height: 1.3; color: var(--text-primary); margin-bottom: 0.4rem; }
  .post-card p { color: var(--text-secondary); font-size: 15px; margin: 0; }
  .blog-empty { color: var(--text-tertiary); font-size: 15px; background: var(--light-surface); border: 1px dashed var(--light-border); border-radius: var(--radius-lg); padding: 2.5rem; text-align: center; }

  /* FOOTER */
  footer { background: #090B0F; padding: 2rem; text-align: center; }
  footer p { font-size: 13px; color: rgba(255,255,255,0.2); }
  footer a { color: rgba(255,255,255,0.35); text-decoration: none; }
  footer a:hover { color: rgba(255,255,255,0.55); }

  @media (max-width: 640px) {
    .nav-links { gap: 1rem; }
    .nav-links a:not(.nav-cta) { display: none; }
  }
{% endblock %}

{% block content %}
<div class="blog-wrap">
  <header class="blog-header">
    <div class="blog-eyebrow">COR Blog</div>
    <h1>GTM, done with fewer people and better systems</h1>
    <p>Practical guidance for lean B2B SaaS teams — warm prospecting, AI search visibility, and content that converts.</p>
  </header>

  {% if collections.posts.length %}
    {% for post in collections.posts %}
    <a class="post-card" href="{{ post.url }}">
      <div class="post-card-meta">
        <span>{{ post.date | dateDisplay }}</span>
        <span>{{ post.templateContent | readingTime }} min read</span>
      </div>
      <h2>{{ post.data.title }}</h2>
      <p>{{ post.data.description }}</p>
    </a>
    {% endfor %}
  {% else %}
    <div class="blog-empty">First articles publishing soon.</div>
  {% endif %}
</div>
{% endblock %}

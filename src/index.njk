{% block styles %}
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --blue: #2B7CE9;
    --blue-dark: #1A5FC4;
    --blue-light: #E8F1FD;
    --sage: #3D9970;
    --sage-light: #E6F4ED;
    --dark-bg: #0D0F14;
    --dark-surface: #161920;
    --dark-border: rgba(255,255,255,0.08);
    --dark-text: #F0F2F7;
    --dark-muted: rgba(240,242,247,0.55);
    --light-bg: #F7F8FA;
    --light-surface: #FFFFFF;
    --light-border: #E4E6EA;
    --text-primary: #111318;
    --text-secondary: #5A5E6B;
    --text-tertiary: #9096A4;
    --font: 'DM Sans', sans-serif;
    --mono: 'DM Mono', monospace;
    --radius: 10px;
    --radius-lg: 16px;
  }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font); font-size: 16px; line-height: 1.6; color: var(--text-primary); background: var(--light-bg); -webkit-font-smoothing: antialiased; }

  /* NAV */
  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(13,15,20,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--dark-border); padding: 0 2rem; height: 60px; display: flex; align-items: center; justify-content: space-between; }
  .nav-logo { text-decoration: none; display: flex; align-items: center; }
  .nav-logo-img { height: 28px; width: auto; }
  .nav-logo span { color: var(--blue); }
  .nav-links { display: flex; align-items: center; gap: 2rem; }
  .nav-links a { color: var(--dark-muted); text-decoration: none; font-size: 14px; font-weight: 400; transition: color 0.2s; }
  .nav-links a:hover { color: #fff; }
  .nav-cta { background: var(--blue) !important; color: #fff !important; padding: 8px 18px; border-radius: 8px; font-weight: 500 !important; font-size: 14px !important; text-decoration: none; transition: background 0.2s; }
  .nav-cta:hover { background: var(--blue-dark) !important; }

  /* HERO */
  .hero { background: var(--dark-bg); min-height: 85vh; display: flex; align-items: center; padding: 88px 2rem 68px; position: relative; overflow: hidden; background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 28px 28px; }
  .hero::before { content: ''; position: absolute; top: -200px; right: -200px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(43,124,233,0.12) 0%, transparent 70%); pointer-events: none; }
  .hero-brandmark { position: absolute; bottom: -120px; left: -160px; width: 680px; height: 680px; pointer-events: none; z-index: 0; opacity: 0.028; }
  .hero-brandmark circle { fill: none; stroke: #ffffff; }
  .hero-inner { max-width: 1180px; margin: 0 auto; width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .hero-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(43,124,233,0.15); border: 1px solid rgba(43,124,233,0.3); color: #7FB3F5; font-size: 12px; font-weight: 500; padding: 5px 12px; border-radius: 100px; margin-bottom: 1.5rem; font-family: var(--mono); letter-spacing: 0.5px; text-transform: uppercase; }
  /* dot indicator removed — badge itself also removed from hero, rule kept dormant in case badge returns */
  .hero h1 { font-size: clamp(36px, 4vw, 54px); font-weight: 600; line-height: 1.1; letter-spacing: -1.5px; color: var(--dark-text); margin-bottom: 1.5rem; }
  /* One-giant-number hero: "3x" is the single focal point, so the headline runs
     white beneath it. To restore the old blue "reply rates." accent instead,
     set the rule below back to color: var(--blue). */
  .hero h1 em { font-style: normal; color: var(--dark-text); }
  .hero-stat { display: block; font-size: clamp(74px, 8.4vw, 122px); font-weight: 700; line-height: 0.86; letter-spacing: -0.055em; color: var(--blue); margin-bottom: 0.1em; }
  .hero-headline-rest { display: block; }
  .hero-sub { font-size: 17px; line-height: 1.75; color: var(--dark-muted); margin-bottom: 2.5rem; max-width: 480px; }
  .hero-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .btn-primary { background: var(--blue); color: #fff; padding: 13px 28px; border-radius: 9px; font-size: 15px; font-weight: 500; text-decoration: none; transition: background 0.2s; display: inline-flex; align-items: center; gap: 6px; }
  .btn-primary:hover { background: var(--blue-dark); }
  .btn-ghost { color: var(--dark-muted); padding: 13px 20px; font-size: 15px; text-decoration: none; transition: color 0.2s; display: inline-flex; align-items: center; gap: 6px; }
  .btn-ghost:hover { color: var(--dark-text); }
  .hero-note { margin-top: 1rem; font-size: 13px; color: rgba(240,242,247,0.3); }

  /* DASHBOARD MOCKUP */
  .dashboard-mockup { background: #161920; border-radius: 14px; border: 1px solid rgba(255,255,255,0.1); overflow: hidden; box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04); }
  .mock-topbar { background: #1C1F28; padding: 10px 14px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid rgba(255,255,255,0.07); }
  .mock-dots { display: flex; gap: 5px; }
  .mock-dot { width: 9px; height: 9px; border-radius: 50%; }
  .mock-dot.r { background: #FF5F56; }
  .mock-dot.y { background: #FFBD2E; }
  .mock-dot.g { background: #27C93F; }
  .mock-url { flex: 1; background: rgba(255,255,255,0.06); border-radius: 5px; padding: 4px 10px; font-size: 11px; font-family: var(--mono); color: rgba(255,255,255,0.35); }
  .mock-body { display: flex; min-height: 320px; }
  .mock-sidebar { width: 48px; background: #13151C; border-right: 1px solid rgba(255,255,255,0.06); display: flex; flex-direction: column; align-items: center; padding: 12px 0; gap: 14px; }
  .mock-sb-icon { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; }
  .mock-sb-icon.active { background: rgba(43,124,233,0.2); }
  .mock-content { flex: 1; padding: 14px; }
  .mock-greeting { font-size: 10px; color: rgba(255,255,255,0.35); margin-bottom: 10px; font-family: var(--mono); }
  .mock-vitals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin-bottom: 12px; }
  .mock-vital { background: #1C1F28; border-radius: 8px; padding: 9px 10px 8px; border: 1px solid rgba(255,255,255,0.06); }
  .mock-vital-label { font-size: 9px; color: rgba(255,255,255,0.35); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px; font-family: var(--mono); }
  .mock-vital-value { font-size: 20px; font-weight: 600; color: #fff; line-height: 1; }
  .mock-vital-sub { font-size: 9px; margin-top: 3px; }
  .mock-vital-sub.up { color: #3D9970; }
  .mock-vital-sub.warn { color: #E8A838; }
  .mock-vital-sub.info { color: rgba(255,255,255,0.3); }
  .mock-section-label { font-size: 9px; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 7px; font-family: var(--mono); }
  .mock-feed { display: flex; flex-direction: column; gap: 6px; }
  .mock-feed-item { background: #1C1F28; border-radius: 7px; padding: 8px 10px; border: 1px solid rgba(255,255,255,0.05); display: flex; align-items: flex-start; gap: 8px; }
  .mock-feed-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; margin-top: 3px; }
  .mock-feed-text { font-size: 9px; color: rgba(255,255,255,0.45); line-height: 1.4; }
  .mock-feed-text strong { color: rgba(255,255,255,0.8); font-weight: 500; }
  .mock-right-rail { width: 76px; border-left: 1px solid rgba(255,255,255,0.06); padding: 12px 8px; display: flex; flex-direction: column; gap: 6px; }
  .mock-qa-label { font-size: 8px; color: rgba(255,255,255,0.25); font-family: var(--mono); margin-bottom: 2px; }
  .mock-qa-btn { background: rgba(43,124,233,0.12); border: 1px solid rgba(43,124,233,0.2); border-radius: 5px; padding: 5px 6px; font-size: 8px; color: #7FB3F5; text-align: left; line-height: 1.3; }

  /* HERO VISUAL */
  .hero-visual { position: relative; display: flex; align-items: center; justify-content: center; }
  .hero-glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 520px; height: 420px; background: radial-gradient(ellipse at center, rgba(43,124,233,0.18) 0%, rgba(43,124,233,0.06) 45%, transparent 70%); pointer-events: none; z-index: 0; border-radius: 50%; }
  .dashboard-mockup { position: relative; z-index: 1; }
  .module-pill { position: absolute; z-index: 2; display: flex; align-items: center; gap: 7px; background: rgba(22,25,32,0.92); border: 1px solid rgba(255,255,255,0.12); backdrop-filter: blur(8px); border-radius: 100px; padding: 7px 14px 7px 10px; font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.85); font-family: var(--font); white-space: nowrap; box-shadow: 0 4px 20px rgba(0,0,0,0.4); }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .dot-blue { background: #2B7CE9; box-shadow: 0 0 6px rgba(43,124,233,0.7); }
  .dot-sage { background: #3D9970; box-shadow: 0 0 6px rgba(61,153,112,0.7); }
  .dot-amber { background: #E8A838; box-shadow: 0 0 6px rgba(232,168,56,0.7); }
  .pill-top-left { top: -18px; left: -20px; animation: float-a 4s ease-in-out infinite; }
  .pill-top-right { top: -18px; right: -16px; animation: float-b 4.5s ease-in-out infinite; }
  .pill-bottom-right { bottom: 24px; right: -20px; animation: float-c 5s ease-in-out infinite; }
  @keyframes float-a { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-7px); } }
  @keyframes float-b { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-9px); } }
  @keyframes float-c { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-6px); } }

  /* LOGO STRIP */
  .logo-strip { background: #000000; border-top: 1px solid rgba(255,255,255,0.07); border-bottom: 1px solid rgba(255,255,255,0.07); padding: 2.5rem 0; }
  .logo-strip-inner { max-width: 1000px; margin: 0 auto; text-align: center; padding: 0 2rem; }
  .logo-strip-label { font-size: 11px; font-weight: 500; color: rgba(255,255,255,0.3); letter-spacing: 1px; text-transform: uppercase; font-family: var(--mono); margin-bottom: 2rem; display: block; }
  .carousel-mask { overflow: hidden; position: relative; }
  .carousel-mask::before, .carousel-mask::after { content: ''; position: absolute; top: 0; bottom: 0; width: 120px; z-index: 2; pointer-events: none; }
  .carousel-mask::before { left: 0; background: linear-gradient(to right, #000000, transparent); }
  .carousel-mask::after { right: 0; background: linear-gradient(to left, #000000, transparent); }
  .carousel-track { display: flex; align-items: center; gap: 0; animation: scroll-logos 28s linear infinite; width: max-content; }
  .carousel-track:hover { animation-play-state: paused; }
  @keyframes scroll-logos { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .carousel-item { display: flex; align-items: center; justify-content: center; width: 220px; flex-shrink: 0; padding: 0 1.5rem; }
  .logo-img { max-width: 130px; max-height: 28px; width: auto; height: auto; object-fit: contain; opacity: 0.65; transition: opacity 0.2s; }
  .logo-img:hover { opacity: 1; }
  .logo-amex { max-height: 56px; max-width: 180px; }
  .logo-betterment { max-height: 56px; max-width: 180px; }
  .logo-surgeone { max-height: 42px; max-width: 160px; }
  .logo-twosigma { max-height: 84px; max-width: 220px; }
  .logo-svg-wrap { display: flex; align-items: center; justify-content: center; width: 220px; flex-shrink: 0; padding: 0 1.5rem; opacity: 0.65; transition: opacity 0.2s; }
  .logo-svg-wrap:hover { opacity: 1; }
  .logo-svg-wrap svg { max-width: 130px; max-height: 28px; width: 100%; height: auto; display: block; }

  /* SECTIONS */
  .section { padding: 6rem 2rem; }
  .section-inner { max-width: 1100px; margin: 0 auto; }
  .section-tag { font-size: 11px; font-weight: 500; color: var(--blue); letter-spacing: 1px; text-transform: uppercase; font-family: var(--mono); margin-bottom: 1rem; display: block; }
  .section-h2 { font-size: clamp(28px, 3vw, 40px); font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; color: var(--text-primary); margin-bottom: 1rem; }
  .section-h2 em { font-style: normal; color: var(--blue); }
  .section-intro { font-size: 17px; color: var(--text-secondary); max-width: 560px; line-height: 1.75; margin-bottom: 3.5rem; }

  /* PROBLEM SECTION */
  .problem-section { background: var(--light-bg); padding: 5rem 2rem; }
  .problem-section-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 280px 1fr; gap: 4rem; align-items: center; }
  .problem-left-sub { font-size: 15px; color: var(--text-secondary); line-height: 1.7; margin-top: 0.75rem; }
  .problem-cards-row { display: flex; align-items: stretch; gap: 0; }
  .prob-card { background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 0.75rem; transition: box-shadow 0.2s, border-color 0.2s; }
  .prob-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
  .prob-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.25rem; }
  .prob-num-icon { display: flex; align-items: center; gap: 8px; }
  .prob-num { font-size: 10px; font-weight: 500; color: var(--text-tertiary); font-family: var(--mono); }
  .prob-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
  .prob-icon-blue { background: rgba(43,124,233,0.1); }
  .prob-icon-amber { background: rgba(196,138,26,0.1); }
  .prob-icon-sage { background: rgba(61,153,112,0.1); }
  .prob-label { font-size: 11px; font-weight: 600; letter-spacing: 0.6px; text-transform: uppercase; font-family: var(--mono); }
  .prob-label-blue { color: var(--blue); }
  .prob-label-amber { color: #B07A10; }
  .prob-label-sage { color: var(--sage); }
  .prob-status { font-size: 11px; font-weight: 500; font-family: var(--mono); padding: 3px 10px; border-radius: 100px; display: inline-flex; align-items: center; gap: 5px; width: fit-content; }
  .prob-status-blue { background: rgba(43,124,233,0.08); color: var(--blue); }
  .prob-status-amber { background: rgba(196,138,26,0.08); color: #B07A10; }
  .prob-status-sage { background: rgba(61,153,112,0.08); color: var(--sage); }
  .prob-quote { font-size: 13.5px; line-height: 1.65; color: var(--text-secondary); flex: 1; }
  .prob-footer { display: flex; flex-direction: column; gap: 6px; padding-top: 0.75rem; border-top: 1px solid var(--light-border); margin-top: auto; }
  .prob-culprit-label { font-size: 10px; color: var(--text-tertiary); font-family: var(--mono); }
  .prob-tools { display: flex; gap: 5px; flex-wrap: wrap; }
  .prob-tool { font-size: 10px; font-family: var(--mono); background: var(--light-bg); border: 1px solid var(--light-border); color: var(--text-tertiary); padding: 2px 8px; border-radius: 4px; }
  .prob-connector { display: flex; align-items: center; padding: 0 4px; flex-shrink: 0; }
  .prob-connector-line { flex: 1; height: 1px; background: var(--light-border); width: 12px; }
  .prob-connector-dot { width: 20px; height: 20px; border-radius: 50%; background: var(--light-surface); border: 1px solid var(--light-border); display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--text-tertiary); flex-shrink: 0; }
  @media (max-width: 900px) {
    .problem-section-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .problem-cards-row { flex-direction: column; }
    .prob-connector { flex-direction: column; padding: 4px 0; }
    .prob-connector-line { width: 1px; height: 12px; }
  }

  /* MODULES */
  .modules-section { background: #0D0F14; padding: 6rem 2rem; position: relative;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 40px 40px; }
  .modules-header { max-width: 1100px; margin: 0 auto 3rem; display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; }
  .modules-section .section-tag { color: #7FB3F5; }
  .modules-section .section-h2 { color: var(--dark-text); }
  .modules-section .section-h2 em { color: var(--blue); }
  .modules-section .btn-outline { border-color: rgba(255,255,255,0.15); color: rgba(255,255,255,0.7); background: transparent; }
  .modules-section .btn-outline:hover { border-color: var(--blue); background: rgba(43,124,233,0.1); color: #7FB3F5; }
  .modules-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .module-card { background: #161920; border: 1px solid rgba(255,255,255,0.08); border-radius: var(--radius-lg); padding: 2rem 1.75rem; transition: border-color 0.2s, box-shadow 0.2s; }
  .module-card:hover { border-color: rgba(43,124,233,0.4); box-shadow: 0 4px 32px rgba(43,124,233,0.1); }
  .module-icon { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; }
  .icon-blue { background: rgba(43,124,233,0.18); }
  .icon-sage { background: rgba(61,153,112,0.18); }
  .icon-amber { background: rgba(196,138,26,0.18); }
  .module-tag { font-size: 10px; font-weight: 500; letter-spacing: 0.8px; text-transform: uppercase; font-family: var(--mono); color: rgba(255,255,255,0.3); margin-bottom: 0.5rem; display: block; }
  .module-name { font-size: 19px; font-weight: 600; color: var(--dark-text); margin-bottom: 0.75rem; letter-spacing: -0.3px; line-height: 1.3; }
  .module-desc { font-size: 14px; color: var(--dark-muted); line-height: 1.7; margin-bottom: 1.25rem; }
  .module-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .pill { font-size: 11px; font-weight: 400; padding: 3px 10px; border-radius: 100px; font-family: var(--mono); border: 1px solid; }
  .pill-blue { background: rgba(43,124,233,0.15); color: #7FB3F5; border-color: rgba(43,124,233,0.3); }
  .pill-sage { background: rgba(61,153,112,0.15); color: #6ECFA4; border-color: rgba(61,153,112,0.3); }
  .pill-amber { background: rgba(196,138,26,0.15); color: #F0C060; border-color: rgba(196,138,26,0.3); }

  /* BLUEPRINT BANNER */
  .blueprint-banner { max-width: 1100px; margin: 0 auto 2rem; background: rgba(43,124,233,0.12); border: 1px solid rgba(43,124,233,0.3); border-radius: var(--radius-lg); padding: 2rem 2.5rem; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; position: relative; overflow: hidden; }
  .blueprint-banner::before { content: ''; position: absolute; top: -60px; right: -60px; width: 200px; height: 200px; background: radial-gradient(circle, rgba(43,124,233,0.2) 0%, transparent 70%); pointer-events: none; }
  .blueprint-banner-text { flex: 1; min-width: 280px; }
  .blueprint-banner-icon { flex-shrink: 0; opacity: 0.9; }
  .blueprint-banner-arrows { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }
  .blueprint-arrow { font-size: 11px; font-family: var(--mono); color: rgba(43,124,233,0.7); background: rgba(43,124,233,0.1); border: 1px solid rgba(43,124,233,0.2); padding: 4px 10px; border-radius: 6px; white-space: nowrap; }
  .blueprint-banner-text h3 { font-size: 17px; font-weight: 600; color: #fff; margin-bottom: 0.4rem; letter-spacing: -0.3px; }
  .blueprint-banner-text p { font-size: 14px; color: var(--dark-muted); line-height: 1.6; }
  .blueprint-banner-cta { background: rgba(43,124,233,0.15); border: 1px solid rgba(43,124,233,0.3); color: #7FB3F5; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500; text-decoration: none; white-space: nowrap; transition: background 0.2s; }
  .blueprint-banner-cta:hover { background: rgba(43,124,233,0.25); }

  /* HOW IT WORKS */
  .how-section { padding: 6rem 2rem; background: var(--light-surface); background-image: radial-gradient(rgba(0,0,0,0.10) 1px, transparent 1px); background-size: 24px 24px; }
  .how-header { max-width: 580px; margin: 0 auto 3.5rem; text-align: center; }
  .how-intro { font-size: 16px; color: var(--text-secondary); line-height: 1.75; margin-top: 0.75rem; }
  .flow-wrap { max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }

  /* Entry pill */
  .flow-step-entry { width: 100%; display: flex; justify-content: center; }
  .flow-entry-pill { display: inline-flex; align-items: center; gap: 10px; background: var(--light-bg); border: 1px solid var(--light-border); border-radius: 100px; padding: 11px 22px; font-size: 14px; font-weight: 500; color: var(--text-primary); }
  .flow-entry-icon { width: 28px; height: 28px; background: rgba(43,124,233,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

  /* Arrow down */
  .flow-arrow-down { display: flex; justify-content: center; margin: 4px 0; }

  /* Cards */
  .flow-step { width: 100%; }
  .flow-card { background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 1.5rem 1.75rem; width: 100%; }
  .flow-card-blueprint { border-color: rgba(43,124,233,0.3); background: linear-gradient(135deg, #FAFCFF, #EEF5FE); }
  .flow-card-presence { border-color: rgba(43,124,233,0.2); }
  .flow-card-scout { border-color: rgba(61,153,112,0.2); }
  .flow-card-content { border-color: rgba(196,138,26,0.2); background: linear-gradient(135deg, #FFFDF8, #FDF7EC); }
  .flow-card-scan { border-color: var(--light-border); }
  .flow-card-header { display: flex; align-items: center; gap: 10px; margin-bottom: 1rem; }
  .flow-card-title { font-size: 16px; font-weight: 600; color: var(--text-primary); }
  .flow-card-desc { font-size: 13.5px; color: var(--text-secondary); line-height: 1.65; margin-bottom: 1rem; }
  .flow-module-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .flow-icon-blue { background: rgba(43,124,233,0.1); }
  .flow-icon-blueprint { background: rgba(43,124,233,0.15); }
  .flow-icon-sage { background: rgba(61,153,112,0.1); }
  .flow-icon-amber { background: rgba(196,138,26,0.1); }
  .flow-auto-badge { margin-left: auto; font-size: 10px; font-family: var(--mono); padding: 3px 9px; border-radius: 100px; background: rgba(43,124,233,0.08); color: var(--blue); border: 1px solid rgba(43,124,233,0.2); }
  .flow-module-badge { margin-left: auto; font-size: 10px; font-family: var(--mono); padding: 3px 9px; border-radius: 100px; border: 1px solid; white-space: nowrap; }
  .flow-badge-blue { background: rgba(43,124,233,0.08); color: var(--blue); border-color: rgba(43,124,233,0.2); }
  .flow-badge-sage { background: rgba(61,153,112,0.08); color: var(--sage); border-color: rgba(61,153,112,0.2); }
  .flow-badge-amber { background: rgba(196,138,26,0.08); color: #B07A10; border-color: rgba(196,138,26,0.2); }

  /* Scan body */
  .flow-scan-body { display: flex; gap: 1.5rem; align-items: center; }
  .flow-scan-browser { background: var(--light-bg); border: 1px solid var(--light-border); border-radius: 8px; padding: 10px 12px; flex: 1; position: relative; }
  .flow-browser-bar { display: flex; gap: 4px; margin-bottom: 10px; }
  .flow-browser-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--light-border); }
  .flow-browser-lines { display: flex; flex-direction: column; gap: 6px; }
  .flow-bline { height: 5px; background: #E4E6EA; border-radius: 3px; }
  .flow-bline-accent { background: rgba(43,124,233,0.3); }
  .flow-scan-crosshair { position: absolute; bottom: 10px; right: 10px; }
  .flow-scan-extracts { display: flex; flex-direction: column; gap: 10px; }
  .flow-extract-item { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-secondary); font-weight: 500; }

  /* Blueprint pillars */
  .flow-blueprint-pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .flow-pillar { background: rgba(43,124,233,0.05); border: 1px solid rgba(43,124,233,0.12); border-radius: 10px; padding: 14px 8px 12px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .flow-pillar-icon { width: 36px; height: 36px; background: rgba(43,124,233,0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center; }
  .flow-pillar span { font-size: 12px; font-weight: 500; color: var(--text-primary); text-align: center; }

  /* Fork SVG */
  .flow-fork-wrap { width: 100%; max-width: 560px; }
  .flow-fork-svg { width: 100%; }
  .flow-fork-svg svg { width: 100%; height: 48px; }

  /* Branches */
  .flow-branches-wrap { width: 100%; max-width: 560px; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .flow-branch-col { display: flex; flex-direction: column; }

  /* Converge SVG */
  .flow-converge-wrap { width: 100%; max-width: 560px; }
  .flow-converge-svg { width: 100%; }
  .flow-converge-svg svg { width: 100%; height: 48px; }

  /* Dark mini illustrations */
  .flow-dark-illus { background: #0D0F14; border-radius: 8px; padding: 12px 14px; }
  .fdi-score-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 10px; }
  .fdi-score { display: flex; flex-direction: column; align-items: center; }
  .fdi-num { font-size: 22px; font-weight: 600; line-height: 1; }
  .fdi-sub { font-size: 9px; font-family: var(--mono); color: rgba(255,255,255,0.3); margin-top: 2px; }
  .fdi-vs { font-size: 10px; color: rgba(255,255,255,0.2); font-family: var(--mono); }
  .fdi-platforms { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 8px; }
  .fdi-platform { font-size: 10px; font-family: var(--mono); padding: 2px 7px; border-radius: 4px; }
  .fdi-present { background: rgba(61,153,112,0.15); color: rgba(61,153,112,0.9); border: 1px solid rgba(61,153,112,0.2); }
  .fdi-missing { background: rgba(220,60,60,0.1); color: rgba(220,100,100,0.8); border: 1px solid rgba(220,60,60,0.15); }
  .fdi-rec { font-size: 10px; font-family: var(--mono); color: rgba(232,168,56,0.85); }
  .fdi-kw-row { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 10px; }
  .fdi-kw { font-size: 10px; font-family: var(--mono); background: rgba(43,124,233,0.1); border: 1px solid rgba(43,124,233,0.2); color: rgba(43,124,233,0.85); padding: 2px 8px; border-radius: 4px; }
  .fdi-prospect { display: flex; align-items: center; gap: 7px; margin-bottom: 6px; }
  .fdi-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .fdi-dot-high { background: #3D9970; }
  .fdi-dot-med { background: #E8A838; }
  .fdi-pname { font-size: 10px; color: rgba(255,255,255,0.65); flex: 1; font-family: var(--mono); }
  .fdi-badge-high { font-size: 9px; font-family: var(--mono); background: rgba(61,153,112,0.15); color: rgba(61,153,112,0.9); padding: 1px 6px; border-radius: 4px; }
  .fdi-badge-med { font-size: 9px; font-family: var(--mono); background: rgba(232,168,56,0.15); color: rgba(232,168,56,0.9); padding: 1px 6px; border-radius: 4px; }

  /* Content tags */
  .flow-content-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .flow-ctag { font-size: 11px; font-family: var(--mono); padding: 3px 10px; border-radius: 100px; border: 1px solid; }
  .flow-ctag-blue { background: rgba(43,124,233,0.07); color: var(--blue); border-color: rgba(43,124,233,0.2); }
  .flow-ctag-sage { background: rgba(61,153,112,0.07); color: var(--sage); border-color: rgba(61,153,112,0.2); }
  .flow-ctag-amber { background: rgba(196,138,26,0.07); color: #B07A10; border-color: rgba(196,138,26,0.2); }

  @media (max-width: 600px) {
    .flow-branches-wrap { grid-template-columns: 1fr; }
    .flow-fork-wrap, .flow-converge-wrap { display: none; }
    .flow-blueprint-pillars { grid-template-columns: repeat(2, 1fr); }
  }

  /* BUTTONS */
  .btn-outline { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--light-border); color: var(--text-primary); padding: 12px 24px; border-radius: 9px; font-size: 15px; font-weight: 500; text-decoration: none; font-family: var(--font); transition: border-color 0.2s, background 0.2s, color 0.2s; }
  .btn-outline:hover { border-color: var(--blue); background: var(--blue-light); color: var(--blue); }

  /* BOTTOM CTA */
  .bottom-cta { background: var(--dark-bg); padding: 7rem 2rem; text-align: center; position: relative; overflow: hidden; }
  .bottom-cta::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 800px; height: 400px; background: radial-gradient(ellipse, rgba(43,124,233,0.1) 0%, transparent 70%); pointer-events: none; }
  .bottom-cta-inner { max-width: 580px; margin: 0 auto; position: relative; }
  .bottom-cta h2 { font-size: clamp(28px, 3vw, 42px); font-weight: 600; color: var(--dark-text); letter-spacing: -0.8px; margin-bottom: 1rem; line-height: 1.15; }
  .bottom-cta p { font-size: 16px; color: var(--dark-muted); margin-bottom: 2.5rem; line-height: 1.7; }
  .waitlist-form { display: flex; gap: 10px; max-width: 420px; margin: 0 auto; }
  .waitlist-input { flex: 1; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 12px 16px; border-radius: 9px; font-size: 15px; font-family: var(--font); outline: none; transition: border-color 0.2s; }
  .waitlist-input::placeholder { color: rgba(255,255,255,0.3); }
  .waitlist-input:focus { border-color: rgba(43,124,233,0.5); }
  .waitlist-submit { background: var(--blue); color: #fff; border: none; padding: 12px 22px; border-radius: 9px; font-size: 15px; font-weight: 500; font-family: var(--font); cursor: pointer; transition: background 0.2s; white-space: nowrap; }
  .waitlist-submit:hover { background: var(--blue-dark); }
  .form-note { margin-top: 0.75rem; font-size: 12px; color: rgba(255,255,255,0.2); }

  /* FOOTER */
  footer { background: #090B0F; padding: 2rem; text-align: center; }
  footer p { font-size: 13px; color: rgba(255,255,255,0.2); }
  footer a { color: rgba(255,255,255,0.35); text-decoration: none; }
  footer a:hover { color: rgba(255,255,255,0.55); }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 3rem; }
    .problems-grid { grid-template-columns: 1fr; }
    .modules-grid { grid-template-columns: 1fr; }
    .modules-header { flex-direction: column; align-items: flex-start; }
    .how-steps { grid-template-columns: 1fr; gap: 2.5rem; }
    .how-steps::before { display: none; }
  }

  /* FLOW ANIMATIONS — trigger once on scroll via IntersectionObserver */

  /* Scan line sweep across browser */
  .flow-scan-line {
    position: absolute;
    top: 28px; left: 0;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, rgba(43,124,233,0.7), transparent);
    transform: translateX(-100%);
    border-radius: 2px;
    pointer-events: none;
  }
  .flow-scan-browser { overflow: hidden; }
  .flow-animated .flow-scan-line { animation: scan-sweep 1.4s ease-in-out forwards; }
  @keyframes scan-sweep {
    0%   { transform: translateX(-100%); opacity: 0; }
    10%  { opacity: 1; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  /* Browser lines draw in */
  .flow-bline {
    transform-origin: left center;
    transform: scaleX(0);
  }
  .flow-animated .flow-bline:nth-child(1) { animation: line-draw 0.5s ease-out 0.3s forwards; }
  .flow-animated .flow-bline:nth-child(2) { animation: line-draw 0.5s ease-out 0.5s forwards; }
  .flow-animated .flow-bline:nth-child(3) { animation: line-draw 0.5s ease-out 0.7s forwards; }
  .flow-animated .flow-bline:nth-child(4) { animation: line-draw 0.5s ease-out 0.9s forwards; }
  .flow-animated .flow-bline:nth-child(5) { animation: line-draw 0.5s ease-out 1.1s forwards; }
  @keyframes line-draw {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* Extract items fade + slide in */
  .flow-extract-item { opacity: 0; transform: translateX(10px); }
  .flow-animated .flow-extract-item:nth-child(1) { animation: fade-slide-in 0.4s ease-out 0.6s forwards; }
  .flow-animated .flow-extract-item:nth-child(2) { animation: fade-slide-in 0.4s ease-out 0.9s forwards; }
  .flow-animated .flow-extract-item:nth-child(3) { animation: fade-slide-in 0.4s ease-out 1.2s forwards; }
  @keyframes fade-slide-in {
    from { opacity: 0; transform: translateX(10px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* Blueprint pillars pop in */
  .flow-pillar { opacity: 0; transform: translateY(8px); }
  .flow-animated .flow-pillar:nth-child(1) { animation: pop-up 0.35s ease-out 0.2s forwards; }
  .flow-animated .flow-pillar:nth-child(2) { animation: pop-up 0.35s ease-out 0.4s forwards; }
  .flow-animated .flow-pillar:nth-child(3) { animation: pop-up 0.35s ease-out 0.6s forwards; }
  .flow-animated .flow-pillar:nth-child(4) { animation: pop-up 0.35s ease-out 0.8s forwards; }
  @keyframes pop-up {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Fork/converge SVG paths draw */
  .flow-fork-path, .flow-converge-path {
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
  }
  .flow-animated .flow-fork-path { animation: path-draw 0.6s ease-out 0.1s forwards; }
  .flow-animated .flow-converge-path { animation: path-draw 0.6s ease-out 0.1s forwards; }
  @keyframes path-draw {
    to { stroke-dashoffset: 0; }
  }

  /* Branch cards slide up */
  .flow-branch-col { opacity: 0; transform: translateY(12px); }
  .flow-animated .flow-branch-col:nth-child(1) { animation: pop-up 0.4s ease-out 0.3s forwards; }
  .flow-animated .flow-branch-col:nth-child(2) { animation: pop-up 0.4s ease-out 0.5s forwards; }

  /* Dark illus items fade in sequentially */
  .fdi-score-row, .fdi-platforms, .fdi-rec,
  .fdi-kw-row, .fdi-prospect { opacity: 0; }
  .flow-animated .fdi-score-row  { animation: fade-in 0.4s ease-out 0.7s forwards; }
  .flow-animated .fdi-platforms  { animation: fade-in 0.4s ease-out 0.9s forwards; }
  .flow-animated .fdi-rec        { animation: fade-in 0.4s ease-out 1.1s forwards; }
  .flow-animated .fdi-kw-row     { animation: fade-in 0.4s ease-out 0.7s forwards; }
  .flow-animated .fdi-prospect:nth-child(2) { animation: fade-in 0.4s ease-out 0.9s forwards; }
  .flow-animated .fdi-prospect:nth-child(3) { animation: fade-in 0.4s ease-out 1.1s forwards; }
  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Content tags slide in */
  .flow-ctag { opacity: 0; transform: translateX(-6px); }
  .flow-animated .flow-ctag:nth-child(1) { animation: fade-slide-in 0.35s ease-out 0.3s forwards; }
  .flow-animated .flow-ctag:nth-child(2) { animation: fade-slide-in 0.35s ease-out 0.5s forwards; }
  .flow-animated .flow-ctag:nth-child(3) { animation: fade-slide-in 0.35s ease-out 0.7s forwards; }

  /* Arrow down pulse once */
  .flow-arrow-down svg { opacity: 0; }
  .flow-animated .flow-arrow-down svg { animation: fade-in 0.4s ease-out 0.1s forwards; }

  /* VIDEO — hero trigger */
  .btn-video { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); color: var(--dark-text); padding: 11px 20px 11px 12px; border-radius: 9px; font-size: 15px; font-weight: 500; font-family: var(--font); cursor: pointer; transition: background 0.2s, border-color 0.2s; }
  .btn-video:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.26); }
  .btn-video-icon { width: 26px; height: 26px; border-radius: 50%; background: var(--blue); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

  /* VIDEO — hero mockup click-to-play overlay */
  .hero-video-overlay { position: absolute; inset: 0; z-index: 5; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; background: rgba(11,13,18,0); border: 0; padding: 0; margin: 0; cursor: pointer; font-family: var(--font); -webkit-appearance: none; appearance: none; transition: background 0.25s ease; }
  .hero-video-overlay:hover, .hero-video-overlay:focus-visible { background: rgba(11,13,18,0.58); }
  .hero-video-overlay:focus-visible { outline: 2px solid var(--blue); outline-offset: -3px; }
  .hero-video-play { position: relative; width: 64px; height: 64px; border-radius: 50%; background: rgba(43,124,233,0.95); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 30px rgba(0,0,0,0.45), 0 0 0 8px rgba(43,124,233,0.14); transition: transform 0.25s ease, box-shadow 0.25s ease; }
  .hero-video-play svg { margin-left: 3px; }
  .hero-video-overlay:hover .hero-video-play, .hero-video-overlay:focus-visible .hero-video-play { transform: scale(1.07); box-shadow: 0 10px 34px rgba(0,0,0,0.5), 0 0 0 12px rgba(43,124,233,0.22); }
  /* Slow pulse so the affordance is discoverable without hovering */
  .hero-video-play::after { content: ''; position: absolute; inset: -1px; border-radius: 50%; border: 2px solid rgba(43,124,233,0.55); animation: hero-video-pulse 2.8s cubic-bezier(0.2, 0.6, 0.35, 1) infinite; pointer-events: none; }
  @keyframes hero-video-pulse { 0% { transform: scale(1); opacity: 0.75; } 70%, 100% { transform: scale(1.8); opacity: 0; } }
  .hero-video-cta { font-size: 14px; font-weight: 500; color: #fff; opacity: 0; transform: translateY(6px); transition: opacity 0.25s ease, transform 0.25s ease; }
  .hero-video-overlay:hover .hero-video-cta, .hero-video-overlay:focus-visible .hero-video-cta { opacity: 1; transform: none; }
  .hero-video-chip { position: absolute; bottom: 12px; right: 12px; font-family: var(--mono); font-size: 11px; line-height: 1; color: rgba(255,255,255,0.9); background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.14); padding: 4px 8px; border-radius: 5px; }
  @media (prefers-reduced-motion: reduce) {
    .hero-video-play::after { animation: none; opacity: 0.5; transform: none; }
    .hero-video-overlay, .hero-video-play, .hero-video-cta { transition: none; }
  }
  /* Touch devices have no hover, so show the label and a light scrim by default */
  @media (hover: none) {
    .hero-video-overlay { background: rgba(11,13,18,0.34); }
    .hero-video-cta { opacity: 1; transform: none; }
  }

  /* VIDEO — how-it-works card */
  .how-video-card { display: flex; align-items: center; gap: 1.25rem; width: 100%; max-width: 560px; margin: 0 auto 3rem; background: var(--light-surface); border: 1px solid var(--light-border); border-radius: var(--radius-lg); padding: 0.85rem; cursor: pointer; transition: box-shadow 0.2s, border-color 0.2s; text-align: left; font-family: inherit; -webkit-appearance: none; appearance: none; }
  .how-video-card:hover { box-shadow: 0 8px 28px rgba(0,0,0,0.08); border-color: rgba(43,124,233,0.3); }
  .how-video-thumb { position: relative; width: 148px; height: 84px; flex-shrink: 0; border-radius: 8px; overflow: hidden; background: #0D0F14; }
  .how-video-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .how-video-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 36px; height: 36px; border-radius: 50%; background: rgba(43,124,233,0.92); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,0.35); }
  .how-video-duration { position: absolute; bottom: 6px; right: 6px; font-size: 10px; font-family: var(--mono); color: #fff; background: rgba(0,0,0,0.55); padding: 2px 6px; border-radius: 4px; }
  .how-video-label-title { display: block; font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px; }
  .how-video-label-sub { display: block; font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

  /* VIDEO — modal */
  .video-modal-overlay { position: fixed; inset: 0; background: rgba(6,7,10,0.86); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 2rem; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
  .video-modal-overlay.open { opacity: 1; pointer-events: auto; }
  .video-modal { position: relative; width: 100%; max-width: 900px; }
  .video-modal-frame { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; border-radius: 12px; overflow: hidden; box-shadow: 0 24px 64px rgba(0,0,0,0.5); }
  .video-modal-frame video { width: 100%; height: 100%; display: block; }
  .video-modal-close { position: absolute; top: -44px; right: 0; width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s; border: none; }
  .video-modal-close:hover { background: rgba(255,255,255,0.2); }
  @media (max-width: 600px) {
    .how-video-card { flex-direction: column; align-items: stretch; }
    .how-video-thumb { width: 100%; height: 160px; }
  }
{% endblock %}

{% block content %}


<!-- HERO -->

<script>
(function() {
  var VIDEO_SRC = '/videos/cor-intro.mp4';
  var overlay = document.getElementById('corVideoOverlay');
  var videoEl = document.getElementById('corVideoEl');
  var hasStarted = false;

  function track(eventName, source) {
    if (typeof gtag === 'function') {
      gtag('event', eventName, {
        video_title: 'COR 45s Intro',
        video_source: source || 'unknown'
      });
    }
  }

  window.openCorVideo = function(source) {
    hasStarted = false;
    videoEl.dataset.source = source || 'unknown';
    if (!videoEl.getAttribute('src')) {
      videoEl.setAttribute('src', VIDEO_SRC);
    }
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    videoEl.currentTime = 0;
    var playPromise = videoEl.play();
    if (playPromise && playPromise.catch) { playPromise.catch(function() {}); }
  };
  window.closeCorVideo = function() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    videoEl.pause();
  };
  window.closeCorVideoBackdrop = function(e) {
    if (e.target === overlay) { closeCorVideo(); }
  };
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) { closeCorVideo(); }
  });

  videoEl.addEventListener('play', function() {
    if (!hasStarted) {
      hasStarted = true;
      track('video_start', videoEl.dataset.source);
    }
  });
  videoEl.addEventListener('ended', function() {
    track('video_complete', videoEl.dataset.source);
  });
})();
</script>

<script>
(function() {
  // Shared helper: wires the bottom demo email form to /api/waitlist.
  function wireEmailForm(opts) {
    var form = document.querySelector(opts.formSelector);
    if (!form) return;
    var emailInput = form.querySelector(opts.inputSelector);
    var submitButton = form.querySelector(opts.buttonSelector);
    var note = form.parentElement.querySelector(opts.noteSelector);

    function setMessage(message, isError) {
      if (!note) return;
      note.textContent = message;
      note.style.color = isError ? '#FCA5A5' : 'rgba(255,255,255,0.45)';
    }

    async function submit() {
      var email = emailInput ? emailInput.value.trim() : '';
      if (!email || email.indexOf('@') === -1) {
        setMessage('Please enter a valid email address.', true);
        return;
      }

      var originalText = submitButton.textContent;
      submitButton.disabled = true;
      submitButton.textContent = opts.loadingText;
      setMessage(opts.sendingText, false);

      try {
        var response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: opts.source })
        });

        if (!response.ok) throw new Error('Request failed');

        submitButton.textContent = opts.doneText;
        setMessage(opts.successText, false);
        if (emailInput) emailInput.value = '';
      } catch (error) {
        submitButton.disabled = false;
        submitButton.textContent = originalText;
        setMessage('Something went wrong. Please try again.', true);
      }
    }

    if (submitButton) submitButton.addEventListener('click', submit);
    if (emailInput) {
      emailInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          submit();
        }
      });
    }
  }

  wireEmailForm({
    formSelector: '.waitlist-form',
    inputSelector: '.waitlist-input',
    buttonSelector: '.waitlist-submit',
    noteSelector: '.form-note',
    source: 'homepage-demo',
    loadingText: 'Sending...',
    sendingText: 'Sending your request...',
    doneText: 'Sent',
    successText: 'Thanks for your interest. Our team will be in touch with you soon.'
  });


  // Each animated card triggers once when 20% visible
  var cards = [
    '.flow-card-scan',
    '.flow-card-blueprint',
    '.flow-branches-wrap',
    '.flow-card-content'
  ];

  if (!('IntersectionObserver' in window)) {
    // Fallback: just show everything
    document.querySelectorAll('.flow-bline, .flow-extract-item, .flow-pillar, .flow-branch-col, .fdi-score-row, .fdi-platforms, .fdi-rec, .fdi-kw-row, .fdi-prospect, .flow-ctag, .flow-arrow-down svg').forEach(function(el) {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
    return;
  }

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('flow-animated');
        observer.unobserve(entry.target); // fire once only
      }
    });
  }, { threshold: 0.2 });

  // Observe each card
  cards.forEach(function(sel) {
    var el = document.querySelector(sel);
    if (el) observer.observe(el);
  });

  // Branches wrap separately
  var branches = document.querySelector('.flow-branches-wrap');
  if (branches) observer.observe(branches);
})();
</script>


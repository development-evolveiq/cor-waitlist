function applyLinks() {
  document.querySelectorAll('[data-plan]').forEach(el => { el.href = URLS.signup; });
  document.querySelectorAll('[data-link="signin"]').forEach(el => { el.href = URLS.signin; });
}

const toggleBtns = document.querySelectorAll('.toggle-btn');
const slider = document.getElementById('toggleSlider');
const priceNums = document.querySelectorAll('.tier-price-num[data-monthly]');
const priceNotes = document.querySelectorAll('.tier-price-note[data-monthly]');

function updateSlider() {
  const active = document.querySelector('.toggle-btn.active');
  if (!active) return;
  const rect = active.getBoundingClientRect();
  const parentRect = active.parentElement.getBoundingClientRect();
  slider.style.left = (rect.left - parentRect.left) + 'px';
  slider.style.width = rect.width + 'px';
}

toggleBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    toggleBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const billing = btn.dataset.billing;
    priceNums.forEach(p => { p.textContent = p.dataset[billing]; });
    priceNotes.forEach(p => { p.innerHTML = p.dataset[billing]; });
    updateSlider();
  });
});

window.addEventListener('load', () => { updateSlider(); applyLinks(); });
window.addEventListener('resize', updateSlider);
</script>


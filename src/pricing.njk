{% block styles %}
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --blue: #2B7CE9;
    --blue-dark: #1A5FC4;
    --blue-light: #E8F1FD;
    --sage: #3D9970;
    --sage-light: #E6F4ED;
    --dark-bg: #0D0F14;
    --dark-surface: #161920;
    --dark-border: rgba(255,255,255,0.08);
    --dark-text: #F0F2F7;
    --dark-muted: rgba(240,242,247,0.55);
    --light-bg: #F7F8FA;
    --light-surface: #FFFFFF;
    --light-border: #E4E6EA;
    --text-primary: #111318;
    --text-secondary: #5A5E6B;
    --text-tertiary: #9096A4;
    --font: 'DM Sans', sans-serif;
    --mono: 'DM Mono', monospace;
    --radius: 10px;
    --radius-lg: 16px;
  }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font); font-size: 16px; line-height: 1.6; color: var(--text-primary); background: var(--light-bg); -webkit-font-smoothing: antialiased; }

  /* NAV */
  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(13,15,20,0.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--dark-border); padding: 0 2rem; height: 60px; display: flex; align-items: center; justify-content: space-between; }
  .nav-logo { text-decoration: none; display: flex; align-items: center; }
  .nav-logo-img { height: 28px; width: auto; }
  .nav-logo span { color: var(--dark-text); font-weight: 600; font-size: 15px; letter-spacing: 0.08em; }
  .nav-logo span em { color: var(--blue); font-style: normal; }
  .nav-links { display: flex; align-items: center; gap: 2rem; }
  .nav-links a { color: var(--dark-muted); text-decoration: none; font-size: 14px; font-weight: 400; transition: color 0.2s; }
  .nav-links a:hover { color: #fff; }
  .nav-links a.active { color: #fff; }
  .nav-cta { background: var(--blue) !important; color: #fff !important; padding: 8px 18px; border-radius: 8px; font-weight: 500 !important; font-size: 14px !important; text-decoration: none; transition: background 0.2s; }
  .nav-cta:hover { background: var(--blue-dark); }
  .btn-ghost-nav { color: var(--dark-muted); font-size: 14px; text-decoration: none; transition: color 0.2s; padding: 8px 12px; }
  .btn-ghost-nav:hover { color: #fff; }
  .btn-primary { background: var(--blue); color: #fff; padding: 8px 18px; border-radius: 8px; font-size: 14px; font-weight: 500; text-decoration: none; transition: background 0.2s; display: inline-flex; align-items: center; gap: 6px; }
  .btn-primary:hover { background: var(--blue-dark); }

  /* HERO */
  .hero {
    background: var(--dark-bg);
    padding: 120px 2rem 72px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -160px;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 500px;
    background: radial-gradient(ellipse at center, rgba(43,124,233,0.14) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-inner { max-width: 640px; margin: 0 auto; position: relative; z-index: 1; }
  .hero-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(43,124,233,0.15); border: 1px solid rgba(43,124,233,0.3); color: #7FB3F5; font-size: 11px; font-weight: 500; padding: 5px 12px; border-radius: 100px; margin-bottom: 1.75rem; font-family: var(--mono); letter-spacing: 0.5px; text-transform: uppercase; }
  /* dot indicator removed — keep label as clean mono text */
  .hero h1 { font-size: clamp(40px, 5.5vw, 68px); font-weight: 600; line-height: 1.05; letter-spacing: -1.5px; color: var(--dark-text); margin-bottom: 1.25rem; }
  .hero h1 em { font-style: normal; color: var(--blue); }
  .hero-sub { font-size: 17px; line-height: 1.75; color: var(--dark-muted); max-width: 480px; margin: 0 auto 2.5rem; }

  /* BILLING TOGGLE */
  .billing-toggle {
    display: inline-flex;
    padding: 4px;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--dark-border);
    border-radius: 100px;
    position: relative;
    gap: 0;
  }
  .toggle-btn {
    padding: 8px 22px;
    border: none;
    background: transparent;
    color: var(--dark-muted);
    font-family: var(--font);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    border-radius: 100px;
    transition: color 0.2s;
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0;
  }
  .toggle-btn.active { color: #fff; }
  .toggle-slider {
    position: absolute;
    top: 4px;
    bottom: 4px;
    background: var(--blue);
    border-radius: 100px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }
  .save-badge {
    background: rgba(43,124,233,0.25);
    color: #7FB3F5;
    font-size: 10px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 100px;
    font-family: var(--mono);
    letter-spacing: 0.03em;
  }
  .toggle-btn.active .save-badge { background: rgba(255,255,255,0.2); color: #fff; }

  /* PRICING SECTION */
  .pricing-section {
    background: var(--dark-bg);
    padding: 0 2rem 6rem;
  }
  .pricing-grid {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding-top: 3rem;
  }
  @media (max-width: 1100px) { .pricing-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .pricing-grid { grid-template-columns: 1fr; } }

  .tier {
    background: var(--dark-surface);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius-lg);
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .tier:hover {
    border-color: rgba(43,124,233,0.35);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }
  .tier.featured {
    border-color: rgba(43,124,233,0.45);
    box-shadow: 0 0 0 1px rgba(43,124,233,0.12), 0 20px 50px -20px rgba(43,124,233,0.3);
  }
  .tier.featured:hover {
    box-shadow: 0 0 0 1px rgba(43,124,233,0.2), 0 24px 60px -20px rgba(43,124,233,0.4);
  }
  .tier-badge {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--blue);
    color: #fff;
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--mono);
    white-space: nowrap;
  }
  .tier-name {
    font-size: 11px;
    font-weight: 500;
    color: rgba(240,242,247,0.4);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--mono);
    margin-bottom: 10px;
  }
  .tier-tagline {
    font-size: 13.5px;
    color: var(--dark-muted);
    margin-bottom: 22px;
    line-height: 1.5;
    min-height: 42px;
  }
  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 2px;
  }
  .tier-price-num {
    font-size: 52px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--dark-text);
    font-variant-numeric: tabular-nums;
  }
  .tier-price-period {
    font-size: 14px;
    color: rgba(240,242,247,0.3);
  }
  .tier-price-note {
    font-size: 11px;
    color: rgba(240,242,247,0.3);
    margin-bottom: 20px;
    min-height: 28px;
    line-height: 1.4;
    font-family: var(--mono);
  }
  .annual-saving { color: var(--blue); font-weight: 500; }
  .tier-cta { margin-bottom: 20px; }
  .tier-cta a {
    display: block;
    text-align: center;
    padding: 11px 16px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.18s;
  }
  .btn-tier {
    background: transparent;
    color: var(--dark-muted);
    border: 1px solid rgba(255,255,255,0.12);
  }
  .btn-tier:hover {
    background: rgba(255,255,255,0.05);
    color: var(--dark-text);
    border-color: rgba(255,255,255,0.2);
  }
  .btn-tier-featured {
    background: var(--blue);
    color: #fff;
    border: 1px solid transparent;
  }
  .btn-tier-featured:hover { background: var(--blue-dark); }

  .tier-divider { height: 1px; background: var(--dark-border); margin-bottom: 18px; }

  .tier-credits {
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--dark-border);
    border-radius: var(--radius);
    padding: 12px 14px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tier.featured .tier-credits {
    background: rgba(43,124,233,0.1);
    border-color: rgba(43,124,233,0.25);
  }

  /* === Coin chip — locked-in design === */
  .credit-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px 2px 6px;
    background: #F5F3FF;
    color: #6B46C1;
    border: 0.5px solid #E9D5FF;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 600;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    flex-shrink: 0;
  }
  .credit-chip svg { width: 11px; height: 11px; flex-shrink: 0; }
  .credit-chip.large {
    padding: 4px 10px 4px 8px;
    font-size: 12px;
    gap: 6px;
  }
  .credit-chip.large svg { width: 13px; height: 13px; }
  /* on dark card surfaces */
  .credit-chip.on-dark {
    background: rgba(255,255,255,0.12);
    color: white;
    border-color: rgba(255,255,255,0.2);
  }
  .credit-chip.on-dark svg .coin-edge { fill: rgba(255,255,255,0.4); }
  .credit-chip.on-dark svg .coin-face { fill: rgba(255,255,255,0.85); }
  .credit-chip.on-dark svg .coin-line { stroke: rgba(255,255,255,0.6); }

  /* Tier credit block icon wrap — stacked coin */
  .credit-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: rgba(107,70,193,0.12);
    border: 1px solid rgba(107,70,193,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #8B5CF6;
  }
  .tier.on-dark-card .credit-icon-wrap,
  .tier .credit-icon-wrap {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.7);
  }
  .credit-icon-wrap svg { width: 20px; height: 20px; }

  .credit-info { flex: 1; }
  .credit-amount {
    font-size: 16px;
    font-weight: 600;
    color: var(--dark-text);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .credit-label { font-size: 11px; color: rgba(240,242,247,0.3); margin-top: 2px; font-family: var(--mono); }

  .tier-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 8px;
    flex: 1;
  }
  .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(240,242,247,0.35);
  }
  .tier-features li.included { color: var(--dark-muted); }
  .feat-check, .feat-x { flex-shrink: 0; margin-top: 2px; width: 14px; height: 14px; }
  .feat-check { color: var(--blue); }
  .feat-x { color: rgba(240,242,247,0.2); }

  /* CREDIT REFERENCE */
  .credit-section {
    background: var(--light-bg);
    padding: 6rem 2rem;
  }
  .credit-section-inner {
    max-width: 1100px;
    margin: 0 auto;
    background: var(--light-surface);
    border: 1px solid var(--light-border);
    border-radius: 24px;
    padding: 56px;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 64px;
    align-items: start;
  }
  @media (max-width: 900px) { .credit-section-inner { grid-template-columns: 1fr; gap: 32px; padding: 36px; } }
  .credit-section-lead .section-tag { font-size: 11px; font-weight: 500; color: var(--blue); letter-spacing: 1px; text-transform: uppercase; font-family: var(--mono); margin-bottom: 1rem; display: block; }
  .credit-section-lead h2 { font-size: clamp(26px, 3vw, 38px); font-weight: 600; line-height: 1.1; letter-spacing: -0.8px; color: var(--text-primary); margin-bottom: 1rem; }
  .credit-section-lead h2 em { font-style: normal; color: var(--blue); }
  .credit-section-lead p { color: var(--text-secondary); font-size: 15px; line-height: 1.7; margin-bottom: 14px; }

  .credit-table { border-top: 1px solid var(--light-border); }
  .credit-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--light-border);
    gap: 24px;
  }
  .credit-row-action { display: flex; align-items: center; gap: 14px; }
  .action-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--light-bg);
    border: 1px solid var(--light-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
    flex-shrink: 0;
  }
  .action-icon svg { width: 16px; height: 16px; }
  .action-info { display: flex; flex-direction: column; gap: 2px; }
  .action-name { font-size: 14px; color: var(--text-primary); font-weight: 500; }
  .action-detail { font-size: 12px; color: var(--text-tertiary); }
  .credit-cost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 10px;
    border-radius: 100px;
    background: #F5F3FF;
    color: #6B46C1;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    border: 0.5px solid #E9D5FF;
    font-family: var(--mono);
    white-space: nowrap;
  }
  .credit-cost svg { width: 13px; height: 13px; flex-shrink: 0; }

  /* PACKS */
  .packs-section {
    background: var(--light-bg);
    padding: 0 2rem 6rem;
  }
  .packs-header { text-align: center; margin-bottom: 3rem; }
  .packs-header .section-tag { font-size: 11px; font-weight: 500; color: var(--blue); letter-spacing: 1px; text-transform: uppercase; font-family: var(--mono); margin-bottom: 0.75rem; display: block; }
  .packs-header h2 { font-size: clamp(28px, 3vw, 40px); font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; color: var(--text-primary); margin-bottom: 0.75rem; }
  .packs-header h2 em { font-style: normal; color: var(--blue); }
  .packs-header p { color: var(--text-secondary); max-width: 440px; margin: 0 auto; font-size: 16px; }
  .packs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 800px;
    margin: 0 auto;
  }
  @media (max-width: 680px) { .packs-grid { grid-template-columns: 1fr; } }
  .pack {
    background: var(--light-surface);
    border: 1px solid var(--light-border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    text-align: center;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    position: relative;
  }
  .pack:hover {
    border-color: rgba(43,124,233,0.3);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(43,124,233,0.08);
  }
  .pack.best { border-color: rgba(43,124,233,0.25); }
  .pack-best-badge {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--blue);
    color: #fff;
    padding: 3px 12px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 500;
    font-family: var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pack-amount {
    font-size: 44px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 4px;
    font-variant-numeric: tabular-nums;
  }
  .pack-label { font-size: 11px; color: var(--text-tertiary); letter-spacing: 0.08em; text-transform: uppercase; font-family: var(--mono); margin-bottom: 18px; }
  .pack-price { font-size: 24px; color: var(--blue); font-weight: 600; margin-bottom: 4px; font-variant-numeric: tabular-nums; }
  .pack-rate { font-size: 11px; color: var(--text-tertiary); font-family: var(--mono); }

  /* FAQ */
  .faq-section { background: var(--light-surface); padding: 6rem 2rem; background-image: radial-gradient(rgba(0,0,0,0.08) 1px, transparent 1px); background-size: 24px 24px; }
  .faq-inner { max-width: 760px; margin: 0 auto; }
  .faq-header { text-align: center; margin-bottom: 3.5rem; }
  .faq-header .section-tag { font-size: 11px; font-weight: 500; color: var(--blue); letter-spacing: 1px; text-transform: uppercase; font-family: var(--mono); margin-bottom: 0.75rem; display: block; }
  .faq-header h2 { font-size: clamp(28px, 3vw, 40px); font-weight: 600; letter-spacing: -0.8px; line-height: 1.15; color: var(--text-primary); }
  .faq-header h2 em { font-style: normal; color: var(--blue); }
  .faq-item { border-bottom: 1px solid var(--light-border); }
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 15.5px;
    font-weight: 500;
    color: var(--text-primary);
    cursor: pointer;
    gap: 24px;
    padding: 20px 0;
    user-select: none;
  }
  .faq-q-icon { flex-shrink: 0; color: var(--text-tertiary); transition: transform 0.2s, color 0.2s; }
  .faq-item.open .faq-q-icon { transform: rotate(45deg); color: var(--blue); }
  .faq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    color: var(--text-secondary);
    font-size: 14.5px;
    line-height: 1.7;
  }
  .faq-item.open .faq-a { max-height: 280px; padding-bottom: 20px; }
  .faq-a em { color: var(--blue); font-style: normal; font-weight: 500; }

  /* BOTTOM CTA */
  .bottom-cta {
    background: var(--dark-bg);
    padding: 6rem 2rem;
    position: relative;
    overflow: hidden;
    background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .bottom-cta::before {
    content: '';
    position: absolute;
    bottom: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(43,124,233,0.1) 0%, transparent 70%);
    pointer-events: none;
  }
  .bottom-cta-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .bottom-cta h2 { font-size: clamp(32px, 4vw, 52px); font-weight: 600; line-height: 1.1; letter-spacing: -1.2px; color: var(--dark-text); margin-bottom: 1.25rem; }
  .bottom-cta h2 em { font-style: normal; color: var(--blue); }
  .bottom-cta p { font-size: 17px; color: var(--dark-muted); max-width: 460px; margin: 0 auto 2.5rem; line-height: 1.75; }
  .bottom-cta .btn-primary { font-size: 15px; padding: 14px 28px; }
  .cta-note { margin-top: 1rem; font-size: 12px; color: rgba(240,242,247,0.25); font-family: var(--mono); }

  /* FOOTER */
  footer { background: #000; border-top: 1px solid rgba(255,255,255,0.07); padding: 2rem; text-align: center; }
  footer p { font-size: 13px; color: rgba(255,255,255,0.25); }
  footer a { color: rgba(255,255,255,0.4); text-decoration: none; }
  footer a:hover { color: rgba(255,255,255,0.7); }
{% endblock %}


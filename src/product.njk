<!-- BOTTOM CTA -->
<section class="bottom-cta" id="waitlist">
  <div class="bottom-cta-inner">
    <h2 id="ctaHeading">Want a walkthrough first?</h2>
    <p id="ctaSub">Leave your email and our team will reach out to find a time that works.</p>
    <div class="waitlist-form">
      <input type="email" class="waitlist-input" placeholder="your@email.com">
      <button class="waitlist-submit" id="ctaSubmit">Book a demo</button>
    </div>
    <p class="form-note" id="ctaNote">We'll reach out to find a time that works.</p>
  </div>
</section>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal, .flow-step').forEach(el => observer.observe(el));

  // Active nav link
  document.querySelectorAll('.nav-links a').forEach(a => {
    if (a.getAttribute('href') === '/product/') a.classList.add('active');
  });

  // Demo request submit
  const demoForm = document.querySelector('.waitlist-form');
  if (demoForm) {
    const emailInput = demoForm.querySelector('.waitlist-input');
    const submitButton = demoForm.querySelector('.waitlist-submit');
    const status = document.querySelector('.form-note');

    function setMessage(message, isError) {
      if (!status) return;
      status.textContent = message;
      status.style.color = isError ? '#FCA5A5' : 'rgba(255,255,255,0.45)';
    }

    async function submitDemoRequest() {
      const email = emailInput ? emailInput.value.trim() : '';

      if (!email || !email.includes('@')) {
        setMessage('Please enter a valid email address.', true);
        return;
      }

      const originalText = submitButton.textContent;
      submitButton.disabled = true;
      submitButton.textContent = 'Sending...';
      setMessage('Sending your request...', false);

      try {
        const response = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: 'product-demo' })
        });

        if (!response.ok) throw new Error('Request failed');

        submitButton.textContent = 'Sent';
        setMessage('Thanks for your interest. Our team will be in touch with you soon.', false);
        if (emailInput) emailInput.value = '';
      } catch (error) {
        submitButton.disabled = false;
        submitButton.textContent = originalText;
        setMessage('Something went wrong. Please try again.', true);
      }
    }

    if (submitButton) submitButton.addEventListener('click', submitDemoRequest);
    if (emailInput) {
      emailInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          submitDemoRequest();
        }
      });
    }
  }
</script>


